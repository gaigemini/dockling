# =============================================================================
# RESUMABLE UPLOAD FLOW
# =============================================================================
# Step 1: Initiate upload session → get upload_id
# Step 2: Send chunk(s) via PUT /upload/{upload_id}
#         (use Content-Range if resuming from a specific offset)
# Step 3: Check upload status via GET /upload/{upload_id}
# Step 4: Use upload_id in /convert or /convert_n_chunk
# =============================================================================


### [Step 1] Upload Init - Start resumable upload session
POST {{host}}api/v1/upload/init
authorization: {{token}}
Content-Type: multipart/form-data; boundary=Ck3m6e-jha83GLt1mB0L2oZpP8kqTDn3AyE7z

--Ck3m6e-jha83GLt1mB0L2oZpP8kqTDn3AyE7z
Content-Disposition: form-data; name="filename"

UUD1945.pdf
--Ck3m6e-jha83GLt1mB0L2oZpP8kqTDn3AyE7z
Content-Disposition: form-data; name="total_size"

1000000
--Ck3m6e-jha83GLt1mB0L2oZpP8kqTDn3AyE7z--
# ↑ Replace total_size with actual file byte size
# Response includes upload_id → use it in subsequent requests


### [Step 2] Upload Chunk - Send (or resume) a file chunk
# Replace {upload_id} with the upload_id from Step 1
# Add Content-Range header when resuming from a specific offset
PUT {{host}}api/v1/upload/REPLACE_WITH_UPLOAD_ID
authorization: {{token}}
Content-Type: application/octet-stream
Content-Range: bytes 0-999999/1000000

< /home/skyfy/Downloads/UUD1945.pdf
# Remove Content-Range header for simple sequential uploads
# Content-Range format: bytes {start}-{end}/{total}


### [Step 3] Upload Status - Check upload progress
GET {{host}}api/v1/upload/REPLACE_WITH_UPLOAD_ID
authorization: {{token}}
Accept: application/json


### [Step 4a] Convert with upload_id - Process an already-uploaded file
POST {{host}}api/v1/convert
