# Production environment template - copy to env/prod.env.
# NOTE: the app refuses to start 'prod' without env/prod.env being present.
TEMP_DIR=uploads/tmp
SUPPORTED_FORMATS=application/pdf,text/plain,text/markdown,text/csv,text/html,application/json,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/*,application/xml
DEFAULT_OCR_LANGS=id,en
MAX_TOKENS=512
MAX_FILE_SIZE=209715200
DEFAULT_CHUNK_TYPE=hybrid
THREAD_POOL_SIZE=4
CONVERTER_NUM_THREADS=6
ENABLE_TABLE_STRUCTURE=true
ENABLE_CELL_MATCHING=true
CORS_ORIGINS=https://your-frontend.example.com
LOG_LEVEL=WARNING
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
DISABLE_AUTH=false
SSO_URL=https://sso.example.com
SSO_REALM=REPLACE_ME
SSO_CLIENT_ID=REPLACE_ME
SSO_CLIENT_SECRET=REPLACE_WITH_SSO_CLIENT_SECRET
SSO_REDIRECT_URI=https://your-domain.example.com
REDIS_URL=redis://redis:6379/0

# MinIO (production object storage)
MINIO_ENABLED=true
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=REPLACE_WITH_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_MINIO_SECRET_KEY
MINIO_BUCKET=docling
MINIO_SECURE=false
MINIO_RESULT_TTL_DAYS=7
