# Test environment template - copy to env/test.env and adjust values.
TEMP_DIR=test_uploads/tmp
SUPPORTED_FORMATS=application/pdf,text/plain
DEFAULT_OCR_LANGS=id
MAX_TOKENS=512
MAX_FILE_SIZE=209715200
DEFAULT_CHUNK_TYPE=hybrid
THREAD_POOL_SIZE=4
CONVERTER_NUM_THREADS=6
ENABLE_TABLE_STRUCTURE=true
ENABLE_CELL_MATCHING=true
CORS_ORIGINS=*
LOG_LEVEL=CRITICAL
SECRET_KEY=test-secret-key
DISABLE_AUTH=true
REDIS_URL=redis://localhost:6379/1

# MinIO (disabled in tests -> local disk fallback)
MINIO_ENABLED=false
MINIO_BUCKET=docling-test
